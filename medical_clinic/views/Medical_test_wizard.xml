<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="Medical_test_wizard_view_form" model="ir.ui.view">
        <field name="name">Medical.test.wizard.view.form</field>
        <field name="model">medical.test.wizard</field>
        <field name="arch" type="xml">
            <form string="Medical Test Report">
                <sheet>
                    <group>
                        <field name="appointment_id"/>
                        <field name="type"/>
                        <field name="category"/>
                    </group>
                </sheet>
                <footer>

                    <button
                        string="Print"
                        type="object"
                        name="action_print"
                        class="btn-primary"/>

                    <button
                        string="Cancel"
                        special="cancel"/>

                </footer>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="Medical_test_wizard_action" model="ir.actions.act_window">
        <field name="name">Medical test wizard</field>
        <field name="res_model">medical.test.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="Medical_test_wizard_view_form"/>
        <field name="target">new</field>

    </record>
    
   <menuitem id="Medical_Test_report" name="Medical Test Report" parent="clinic_Report" sequence="2" action="Medical_test_wizard_action" />

</odoo>