<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="WorkingDr_view_form" model="ir.ui.view">
        <field name="name">WorkingDr.view.form</field>
        <field name="model">working.dr</field>
        <field name="arch" type="xml">
            <form string="WorkingDr">
                <sheet>
                    <group>
                        <field name="day" string="Day"/>
                        <field name="from_hour" string="From Hour"/>
                        <field name="to_hour" string="To hour"/>
                        <field name="doctor_id" string="Doctor"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- List View -->
    <record id="WorkingDr_view_list" model="ir.ui.view">
    <field name="name">WorkingDr.view.list</field>
    <field name="model">working.dr</field>
    <field name="arch" type="xml">
        <list string="WorkingDr" editable="bottom">
            <field name="day"/>
            <field name="from_hour" widget="float_time"/>
            <field name="to_hour" widget="float_time"/>
            <field name="doctor_id"/>
        </list>
    </field>
</record>
    
    <!-- Action -->
    <record id="WorkingDr_action" model="ir.actions.act_window">
        <field name="name">WorkingDr</field>
        <field name="res_model">working.dr</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first WorkingDr!
            </p>
        </field>
    </record>
    
    <!-- Menu -->
        <menuitem id="clinic_WorkingDr" name="working Hour Dr" parent="clinic_configration" sequence="2" action="WorkingDr_action" />

</odoo>