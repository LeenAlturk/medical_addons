<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="dashboard_record" model="clinic.dashboard">
        <field name="name">Dashboard</field>
    </record>

    <record id="dashboard_view_form" model="ir.ui.view">
        <field name="name">dashboard.view.form</field>
        <field name="model">clinic.dashboard</field>
        <field name="arch" type="xml">
            <form string="Dashboard" create="0" edit="0" class="o_form_nosheet">

                <div class="container-fluid" style="padding: 25px; background: #fdfdfd;">
                    <div class="row">

                        <div class="col-md-6" style="padding: 15px;">
                            <div style="position: relative; background: #E3F2FD; border-radius: 16px; padding: 35px 20px; text-align: center; box-shadow: 0 4px 20px rgba(30, 136, 229, 0.15); border: 1px solid #BBDEFB; transition: transform 0.2s;">

                                <button name="action_open_patients" type="object"
                                        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; z-index: 10; border: none; background: none;"/>

                                <i class="fa fa-users fa-3x" style="color: #1E88E5; margin-bottom: 15px; display: block;"/>
                                <h3 style="color: #1565C0; font-size: 22px; font-weight: 600; margin-bottom: 10px;">Patients</h3>
                                <div style="color: #0D47A1; font-size: 48px; font-weight: 800; line-height: 1;">
                                    <field name="patient_count" readonly="1"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6" style="padding: 15px;">
                            <div style="position: relative; background: #E8F5E9; border-radius: 16px; padding: 35px 20px; text-align: center; box-shadow: 0 4px 20px rgba(67, 160, 71, 0.15); border: 1px solid #C8E6C9; transition: transform 0.2s;">

                                <button name="action_open_doctors" type="object"
                                        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; z-index: 10; border: none; background: none;"/>

                                <i class="fa fa-user-md fa-3x" style="color: #43A047; margin-bottom: 15px; display: block;"/>
                                <h3 style="color: #2E7D32; font-size: 22px; font-weight: 600; margin-bottom: 10px;">Doctors</h3>
                                <div style="color: #1B5E20; font-size: 48px; font-weight: 800; line-height: 1;">
                                    <field name="doctor_count" readonly="1"/>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="row">

                        <div class="col-md-6" style="padding: 15px;">
                            <div style="position: relative; background: #FFF3E0; border-radius: 16px; padding: 35px 20px; text-align: center; box-shadow: 0 4px 20px rgba(251, 140, 0, 0.15); border: 1px solid #FFE0B2; transition: transform 0.2s;">

                                <button name="action_open_appointments" type="object"
                                        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; z-index: 10; border: none; background: none;"/>

                                <i class="fa fa-calendar fa-3x" style="color: #FB8C00; margin-bottom: 15px; display: block;"/>
                                <h3 style="color: #EF6C00; font-size: 22px; font-weight: 600; margin-bottom: 10px;">Appointments</h3>
                                <div style="color: #E65100; font-size: 48px; font-weight: 800; line-height: 1;">
                                    <field name="appointment_count" readonly="1"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6" style="padding: 15px;">
                            <div style="position: relative; background: #F3E5F5; border-radius: 16px; padding: 35px 20px; text-align: center; box-shadow: 0 4px 20px rgba(142, 36, 170, 0.15); border: 1px solid #E1BEE7; transition: transform 0.2s;">

                                <button name="action_open_invoices" type="object"
                                        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; z-index: 10; border: none; background: none;"/>

                                <i class="fa fa-file-text-o fa-3x" style="color: #8E24AA; margin-bottom: 15px; display: block;"/>
                                <h3 style="color: #6A1B9A; font-size: 22px; font-weight: 600; margin-bottom: 10px;">Invoices</h3>
                                <div style="color: #4A148C; font-size: 48px; font-weight: 800; line-height: 1;">
                                    <field name="invoice_count" readonly="1"/>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </form>
        </field>
    </record>

    <record id="dashboard_action" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">clinic.dashboard</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="dashboard_record"/>
    </record>

    <menuitem id="dashboard_menu"
              name="Dashboard"
              parent="clinic_root"
              action="dashboard_action"
              sequence="1"/>

</odoo>