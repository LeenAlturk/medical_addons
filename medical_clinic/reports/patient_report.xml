<odoo>

    <!-- Report Action -->
    <record id="patient_report_action" model="ir.actions.report">
        <field name="name">Patient Report</field>
        <field name="model">patient.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">medical_clinic.patient_report_template</field>
        <field name="report_file">medical_clinic.patient_report_template</field>
    </record>

    <!-- MAIN TEMPLATE (مهم جداً) -->
    <template id="patient_report_template">
        <t t-call="web.html_container">
                <t t-call="medical_clinic.patient_report_document"/>
        </t>
    </template>

    <!-- DOCUMENT TEMPLATE -->
    <template id="patient_report_document">

        <t t-call="web.external_layout">
            <div class="page">

                <h2>Patient Report</h2>

                <p>From: <t t-esc="date_from"/></p>
                <p>To: <t t-esc="date_to"/></p>

                <table class="table table-bordered">
    <thead>
        <tr>
            <th>Patient</th>
            <th>Visit Date</th>
            <th>Revision Appointment</th>
            <th>Doctor</th>
        </tr>
    </thead>

    <tbody>
        <t t-foreach="docs" t-as="rec">
            <tr>
                <td>
                    <t t-esc="rec['patient']"/>
                </td>

                <td>
                    <t t-esc="rec['visit_date']"/>
                </td>

                <td>
                    <t t-esc="rec['next_date']"/>
                </td>

                 <td>
                    <t t-esc="rec['doctor']"/>
                </td>
            </tr>
        </t>
    </tbody>
</table>

            </div>
        </t>

    </template>

</odoo>