<odoo>


    <record id="Contacts_patient" model="ir.ui.view">
      <field name="name">patient list</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref = "base.view_partner_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='vat']" position="after">
        <field name="is_patient"/>
        <field name="birthdate"/>
         <field name="age"/>
         <field name="is_active_patient" readonly="1"/>
         <field name="gender"/>
         <field name="is_verified" readonly="1"/>
        </xpath>

        <xpath expr="//field[@name='vat']" position="attributes">
            <attribute name="invisible">[('is_patient','=',True)]</attribute>
        </xpath>


        <xpath expr="//field[@name='function']" position="attributes">
            <attribute name="invisible">[('is_patient','=',True)]</attribute>
        </xpath>


        <xpath expr="//field[@name='website']" position="attributes">
            <attribute name="invisible">[('is_patient','=',True)]</attribute>
        </xpath>


        <xpath expr="//field[@name='title']" position="attributes">
            <attribute name="invisible">[('is_patient','=',True)]</attribute>
        </xpath>


        <xpath expr="//page[@name='sales_purchases']" position="attributes">
            <attribute name="invisible">[('is_patient','=',True)]</attribute>
        </xpath>

        <xpath expr="//field[@name='company_type']" position="attributes">
            <attribute name="invisible">[('is_patient','=',True)]</attribute>
        </xpath>


        <xpath expr="//field[@name='parent_id']" position="attributes">
            <attribute name="invisible">[('is_patient','=',True)]</attribute>
        </xpath>
        <xpath expr="//notebook" position="inside">

            <page string="Chronic Diseases">

                <field name="chronic_disease_ids">
                    <list editable="bottom">
                        <field name="name"/>
                        <field name="status"/>
                    </list>
                </field>

            </page>

        </xpath>
       <xpath expr="//div[@name='button_box']" position="inside">
         <button name ="get_appointments" type="object" class="oe_stat_button" icon="fa-calendar"  >
          <field name="app_count" string="Appointments" widget="statinfo" />
         </button>
       </xpath>

       <xpath expr="//div[@name ='button_box'] " position="inside">
           <button name="get_next_app" type="object" class="oe_stat_button" icon="fa-calendar-check-o">
            <field name="next_app" string="Revision Appointments" widget="statinfo"/>
           </button>
       </xpath>
      </field>
    </record>


    <record id="patient_view_list" model="ir.ui.view">
        <field name="name">patient.view.list</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref = "base.view_partner_tree"/>
        <field name="arch" type="xml">
            <!-- Hide Salesperson -->
        <xpath expr="//field[@name='user_id']" position="attributes">
            <attribute name="column_invisible">1</attribute>
        </xpath>

        <!-- Hide Activities -->
        <xpath expr="//field[@name='activity_ids']" position="attributes">
            <attribute name="column_invisible">1</attribute>
        </xpath>

        </field>
    </record>

    <record model="ir.actions.act_window" id = "clinic_patient_action" >
        <field name="res_model">res.partner</field>
        <field name="name">Patient</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('is_patient','=',True)]</field>
        <field name ="help" type="html">
            <p class ="o_view_noncontent_smiling_face">
                List of Patients
            </p>
        </field>

    </record>

    <menuitem id="clinic_root" name="Clinic Al Rahma" sequence="0"/>
    <menuitem id="clinic_patient" name="Patient" parent = "clinic_root" sequence="2" action = "clinic_patient_action"/>


</odoo>
