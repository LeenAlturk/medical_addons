<odoo>
    <record id="group_doctor" model="res.groups">
    <field name="name">Doctor</field>
</record>

<record id="group_supervisor" model="res.groups">
    <field name="name">Supervisor</field>
</record>

<record id="group_receptionist" model="res.groups">
    <field name="name">Receptionist</field>
</record>

<record id="group_laboratory_technician" model="res.groups">
    <field name="name">Laboratory Technician</field>
</record>

<record model="ir.rule" id="appointment_rule_doctor">
    <field name="name">Doctor appointments only</field>
    <field name="model_id" ref="model_the_appointments"/>
    <field name="groups" eval="[(4, ref('medical_clinic.group_doctor'))]"/>
    <field name="domain_force">
        [('doctor_id', '=', user.id)]
    </field>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="True"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
</record>
    <record model="ir.rule" id="appointment_rule_supervisor">
    <field name="name">Supervisor sees all</field>
    <field name="model_id" ref="model_the_appointments"/>
    <field name="groups" eval="[(4, ref('medical_clinic.group_supervisor'))]"/>
    <field name="domain_force">
        [(1, '=', 1)]
    </field>
</record>
    <record model="ir.rule" id="Next_appointment_doctor" >
        <field name="name"> Doctor see NextApp</field>
        <field name="model_id" ref="model_next_appointments"/>
        <field name="groups" eval="[(4, ref('medical_clinic.group_doctor'))]"/>
        <field name="domain_force">
        [('doctor_id', '=', user.id)]
    </field>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="True"/>
    <field name="perm_create" eval="True"/>
    <field name="perm_unlink" eval="False"/>
    </record>

<record model="ir.rule" id="patient_rule_doctor">
    <field name="name">Doctor sees his patients only</field>
    <field name="model_id" ref="base.model_res_partner"/>
