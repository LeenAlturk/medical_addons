<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List View -->
    <record id="next_appointments_tree" model="ir.ui.view">
        <field name="name">next.appointments.tree</field>
        <field name="model">next.appointments</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="next_app_date"/>
                <field name="last_appointment_id"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="next_appointments_form" model="ir.ui.view">
        <field name="name">next.appointments.form</field>
        <field name="model">next.appointments</field>
        <field name="arch" type="xml">
            <form>
                  <header>
                <button name="button_in_scheduled" class="oe_highlight" string="scheduled" type="object" invisible="state != 'draft'"/>
                <button name="button_in_confirm" class="oe_highlight" string="confirm" type="object" invisible="state != 'scheduled'"/>
                <button name="button_in_done" class="oe_highlight" string="Done" type="object" invisible="state != 'confirm'"/>

                <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,confirm,done"/>
            </header>
                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="next_app_date"/>
                        </group>
                        <group>
                            <field name="last_appointment_id"/>
                            <field name="last_app_date"/>
                            <field name="last_doctor_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Note">
                            <field name="note"/>
                        </page>

                        <page string="Medical Docs">
                        <group>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </group>
                    </page>

                    <page string="Prescription">
    <field name="Prescription_ids">
        <list editable="bottom">
            <field name="medicine_id"/>
            <field name="dosage"/>
            <field name="unit"/>
            <field name="frequency"/>
            <field name="time"/>
            <field name="food_relation"/>
            <field name="duration"/>
        </list>
    </field>
</page>
                    </notebook>



                </sheet>
                <div>
                    <chatter/>
                </div>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="next_appointments_action" model="ir.actions.act_window">
        <field name="name">Revision Appointments</field>
        <field name="res_model">next.appointments</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
    </record>

    <!-- Menu -->
    <menuitem
        id="clinic_next_appointments"
        name="Revision Appointments"
        parent="clinic_app_menu"
        sequence="1"
        action="next_appointments_action"
    />

</odoo>
